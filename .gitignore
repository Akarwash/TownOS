# macOS
.DS_Store

# Build artifacts
*.o
minios.elf
minios.bin

# User programs, built separately and copied onto the disk image. The second
# pattern is needed as well as the first: `user/*.ELF` does NOT match a
# subdirectory, so without it the test fixtures' binaries get committed as source.
user/*.ELF
user/tests/*.ELF

# Disk image for the ATA driver (generated by make)
disk.img
